<?xml version="1.0" encoding="utf-8"?>
<!--
  No <uses-permission> tags on purpose: the app cannot reach the internet,
  so it cannot show ads, track anyone, or download anything.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app find the phone's text-to-speech engine to say color names. Not a permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      enableOnBackInvokedCallback: Back goes to MainActivity's OnBackInvokedCallback on Android 13
      and newer, not only from Android 16 on, so every newer phone handles it the same way.
    -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustDoodles">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Lets a grown-up share a drawing. Not exported: another app can only read the one
          picture it was handed through the share sheet. No storage permission needed.
        -->
        <provider
            android:name=".SharedFiles"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
