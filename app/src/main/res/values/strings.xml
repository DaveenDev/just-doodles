    <!-- Grown-up settings -->
    <string name="parent_title">For grown-ups</string>
    <string name="parent_about">Just Doodles has no ads, no in-app purchases and no internet access, and it collects nothing. Made by DaveenDev.</string>
    <string name="parent_sounds">Sounds</string>
    <string name="parent_sounds_detail">Gentle notes, pops and crayon sounds.</string>
    <string name="parent_voice">Say the names</string>
    <string name="parent_voice_detail">Says colors and tools out loud when they\'re tapped.</string>
    <string name="parent_voice_pick">Voice</string>
    <string name="parent_voice_pick_detail">Which of this phone\'s voices says the names. Tap the arrows to hear each one. Only voices that work without the internet are used, so nothing leaves the phone. More voices opens Android\'s speech settings, where you can download more.</string>
    <string name="parent_voice_auto">Automatic</string>
    <string name="parent_voice_auto_now">Automatic: the clearest of %1$d voices (%2$s)</string>
    <string name="parent_voice_now">Voice %1$d of %2$d (%3$s)</string>
    <string name="parent_voice_none">This phone has no voice that works without the internet yet. Tap More voices to download one.</string>
    <string name="parent_voice_more">More voices</string>
    <string name="parent_baby">Baby mode (ages 1–2)</string>
    <string name="parent_baby_detail">No buttons: every touch makes colors, shapes and music. To leave, hold the gear in the corner.</string>
    <string name="parent_bedtime">Bedtime timer</string>
    <string name="parent_bedtime_detail">When time is up, the picture fades under a sleepy moon with a lullaby, and drawing stops. To start again, hold the gear for 2 seconds.</string>
    <string name="parent_bedtime_off">Off</string>
    <string name="parent_bedtime_minutes">%1$d min</string>
    <string name="parent_bedtime_left">Bedtime in %1$d min</string>
    <string name="parent_pin">Pin the app</string>
    <string name="parent_pin_detail">Keeps the phone in Just Doodles until you unpin it. Android asks you to confirm. To unpin, hold Back and Recent apps together (with gesture navigation, swipe up and hold), or tap Unpin here.</string>
    <string name="parent_pin_button">Pin</string>
    <string name="parent_unpin_button">Unpin</string>
    <string name="parent_done">Done</string>
    <string name="parent_gear">Grown-up settings (hold for 2 seconds)</string>
    <string name="parent_drawings">Drawings: save, share or delete</string>
    <string name="parent_support">♥  Support the developer</string>

